# Serwer gry bez Dockera, jako usługa systemd.
# Zakłada repo w /opt/orlog i virtualenv w /opt/orlog/venv (zob. README, „Serwer w internecie”).
#   sudo cp deploy/orlog.service /etc/systemd/system/
#   sudo systemctl enable --now orlog
[Unit]
Description=Serwer gry Orlog
After=network-online.target
Wants=network-online.target

[Service]
User=orlog
WorkingDirectory=/opt/orlog/backend
# jeden proces, bo stoły są w pamięci; wątki obsługują połączenia graczy
ExecStart=/opt/orlog/venv/bin/gunicorn --workers 1 --threads 200 --bind 0.0.0.0:5000 main:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
